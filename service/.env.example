# Copy this file to .env and fill in the token. Never commit .env.
HOME_ASSISTANT_URL=http://192.168.1.11
# Create in Home Assistant: Profile > Security > Long-lived access tokens
HOME_ASSISTANT_TOKEN=
POCKETBASE_URL=http://127.0.0.1:8090
HOST=127.0.0.1
PORT=8787

# Mail (optional). It only starts when all four values below are set, so leave
# them empty in development to keep a dev copy away from the mailbox.
# Google account > Security > 2-Step Verification > App passwords. Use the
# 16-character app password, not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# A PocketBase user the service signs in as. Create it by hand in the
# PocketBase admin (Collections > users > New record) with exactly this email.
# The mails collection only lets this user change mail.
POCKETBASE_SERVICE_EMAIL=service@life-app.local
POCKETBASE_SERVICE_PASSWORD=

# Garmin (optional). It only starts when GARMIN_API_KEY and the service user
# above are set. Create the key while signed in to Garmin Connect on the web:
# Settings > Personal API Key > Create Key. It is shown only once, so paste
# it straight in here. Read-only: the service never changes anything at Garmin.
GARMIN_API_KEY=
# The day the key runs out, as 2027-11-06, so the app can remind you two
# weeks before. Optional.
GARMIN_API_KEY_EXPIRES=
# Where you live, for which day a sync counts as today.
GARMIN_TIME_ZONE=Europe/Stockholm
